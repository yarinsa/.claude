# Copy to config.env and edit. config.env is gitignored; never commit real values.
# Every script also accepts these as plain environment variables.
# Your ID number and login token are NOT configured here: `iec login` stores them in the Keychain.

# Where the DB, raw responses, CSV archive, venv and logs live.
#IEC_DATA_DIR=$HOME/Library/Application Support/iec-meter

# iec-api version installed by setup.sh.
#PIN=0.5.16

# launchd job label and daily run time (local).
#LAUNCH_LABEL=com.claude.iec-meter
#FETCH_HOUR=7
#FETCH_MINUTE=13
