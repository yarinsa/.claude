# Copy to config.env and edit. config.env is gitignored; never commit real values.
# Every script also accepts these as plain environment variables.

# Org whose Projects V2 access is probed by diagnose.sh.
# Leave unset to probe your own user projects instead.
#GITHUB_ORG=my-org

# Project directory whose Claude Code scope gets the MCP server.
# Defaults to the current working directory.
#PROJECT_DIR=$HOME/Code/my-repo

# Pin the github-projects server version instead of tracking latest.
#PIN=4.0.3

# launchd label for the GUI token agent.
#LAUNCH_LABEL=com.claude.ghtoken
